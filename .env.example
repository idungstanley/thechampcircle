# Copy to .env.local for local development.
# Paystack secret key: sk_test_... for testing, sk_live_... for production.
# Dashboard → Settings → API Keys & Webhooks. Never share it or put it in client code.
PAYSTACK_SECRET_KEY=

# Bachs secret key for dollar payments from outside Nigeria (sk_sandbox_... to test, sk_live_... for real)
BACHS_SECRET_KEY=
